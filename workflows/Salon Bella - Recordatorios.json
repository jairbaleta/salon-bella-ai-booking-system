    {
      "parameters": {
        "jsCode": "const ahora = new Date();\nconst en24horas = new Date(ahora.getTime() + 24 * 60 * 60 * 1000);\n\nconst citas = $input.all();\n\nconst citasFiltradas = citas.filter(cita => {\n  const fechaCita = new Date(cita.json.fecha_hora);\n  return fechaCita >= ahora && fechaCita <= en24horas;\n});\n\nreturn citasFiltradas.map(cita => ({\n  json: {\n    cita_id: cita.json.id,\n    cliente_nombre: cita.json.clientes.nombre_completo,\n    cliente_email: cita.json.clientes.email,\n    cliente_telefono: cita.json.clientes.telefono,\n    servicio: cita.json.servicios.nombre,\n    fecha_hora: cita.json.fecha_hora,\n    fecha_formateada: new Date(cita.json.fecha_hora).toLocaleString('es-CO', {\n      day: '2-digit',\n      month: '2-digit',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: false,\n      timeZone: 'America/Bogota'\n    }),\n    notas: cita.json.notas\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
