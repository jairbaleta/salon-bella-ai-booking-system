      "id": "7dc5339c-beef-4031-9b36-62075ab500d5",
      "name": "Insertar Cita IA"
    },
    {
      "parameters": {
        "jsCode": "const accion = $('Procesar Respuesta IA').item.json.accion;\nconst servicio = $('Buscar ID Servicio IA').item.json.nombre;\n\nconst fecha = new Date(accion.fecha_hora);\nconst fechaFormateada = fecha.toLocaleString('es-CO', {\n  day: '2-digit',\n  month: 'long',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n  timeZone: 'America/Bogota'\n});\n\nreturn [{\n  json: {\n    respuesta: `✅ ¡Tu reserva ha sido confirmada!\\n\\n💅 Servicio: ${servicio}\\n🗓 Fecha y hora: ${fechaFormateada}\\n👤 Cliente: ${accion.nombre_completo}\\n📍 Salón Bella\\n\\nRecibirás un recordatorio automático antes del turno. ¡Te esperamos! 💕`,\n    cita_registrada: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
